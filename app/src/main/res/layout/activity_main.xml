<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ===== 主內容（全螢幕地圖 + 浮動控制） ===== -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 全螢幕地圖 -->
        <org.osmdroid.views.MapView
            android:id="@+id/map_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 地圖中心準星（偏移量補償底部列高度約78dp） -->
        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:layout_marginBottom="78dp"
            android:src="@drawable/ic_crosshair"
            android:contentDescription="地圖中心點"
            android:elevation="2dp" />

        <!-- 模擬中徽章（頂部中央） -->
        <TextView
            android:id="@+id/tv_sim_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="14dp"
            android:background="@drawable/badge_active"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="● 模擬中"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- 頂部左側：開啟選單按鈕 -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_menu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="10dp"
            android:contentDescription="開啟選單"
            app:srcCompat="@android:drawable/ic_menu_sort_by_size"
            app:fabSize="mini"
            app:backgroundTint="@color/primary"
            android:elevation="6dp" />

        <!-- 頂部右側：搜尋按鈕 -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_search"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="10dp"
            android:contentDescription="搜尋"
            app:srcCompat="@android:drawable/ic_menu_search"
            app:fabSize="mini"
            app:backgroundTint="@color/primary"
            android:elevation="6dp" />

        <!-- 停止模擬 FAB（模擬時才顯示） -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btn_stop_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="142dp"
            android:contentDescription="停止模擬"
            app:srcCompat="@android:drawable/ic_media_pause"
            app:fabSize="mini"
            app:backgroundTint="#E53935"
            android:visibility="gone"
            android:elevation="6dp" />

        <!-- 右下：返回目前位置 FAB -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_my_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="90dp"
            android:contentDescription="返回目前位置"
            app:srcCompat="@android:drawable/ic_menu_mylocation"
            app:fabSize="mini"
            app:backgroundTint="#FFFFFF"
            app:tint="@color/primary"
            android:elevation="6dp" />

        <!-- 底部資訊列 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:background="#F4FFFFFF"
            android:elevation="4dp">

            <!-- 狀態訊息 -->
            <TextView
                android:id="@+id/tv_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="6dp"
                android:text="就緒"
                android:textColor="#757575"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- 座標列 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="8dp"
                android:paddingBottom="6dp">

                <TextView
                    android:id="@+id/tv_map_coords"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="25.033000, 121.565400"
                    android:textSize="13sp"
                    android:textColor="#1A1A1A"
                    android:fontFamily="monospace" />

                <!-- 複製座標按鈕 -->
                <ImageButton
                    android:id="@+id/btn_copy_coords"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:src="@android:drawable/ic_menu_share"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:tint="#1976D2"
                    android:scaleType="centerInside"
                    android:padding="6dp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="複製座標" />

                <!-- 設定此位置按鈕 -->
                <Button
                    android:id="@+id/btn_set_here"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="📍 設定"
                    android:textSize="12sp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp" />

            </LinearLayout>
        </LinearLayout>

    </FrameLayout>

    <!-- ===== 左側抽屜（只顯示功能表選項，點擊彈出視窗） ===== -->
    <LinearLayout
        android:layout_width="260dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="#FFFFFF">

        <!-- 抽屜標題 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/primary"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="44dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛰  GPS 模擬器"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="點擊項目開啟設定"
                android:textColor="#BBFFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 分隔線 -->
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E0E0E0" />

        <!-- 第 1 項：設定位置清單 -->
        <LinearLayout
            android:id="@+id/header_location"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="16dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📍  設定位置清單"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#212121" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#757575"
                android:textSize="22sp" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" android:layout_marginStart="18dp" />

        <!-- 第 2 項：設定位置歷史紀錄 -->
        <LinearLayout
            android:id="@+id/header_history"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="16dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📋  設定位置歷史紀錄"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#212121" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#757575"
                android:textSize="22sp" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" android:layout_marginStart="18dp" />

        <!-- 第 3 項：路徑規劃清單 -->
        <LinearLayout
            android:id="@+id/header_route"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="16dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🗺  路徑規劃清單"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#212121" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#757575"
                android:textSize="22sp" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E0E0E0" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
