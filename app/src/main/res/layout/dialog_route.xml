<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="14dp">

    <!-- 路徑點列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_waypoints"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false"
        android:background="#F5F5F5"
        android:padding="2dp" />

    <TextView
        android:id="@+id/tv_no_waypoints"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center"
        android:text="尚未新增路徑點"
        android:textColor="#757575"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- 新增 / 清除 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/btn_add_waypoint"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="＋ 新增路徑點"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_clear_route"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="🗑 清除"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 時速控制 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="10dp"
        android:background="#E8EAF6"
        android:padding="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚗 時速"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btn_speed_minus"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:text="-"
            android:textSize="18sp"
            android:padding="0dp" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_speed_value"
            android:layout_width="60dp"
            android:layout_height="38dp"
            android:gravity="center"
            android:inputType="number"
            android:text="30"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:background="@android:color/white"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:maxLength="3" />

        <Button
            android:id="@+id/btn_speed_plus"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:text="+"
            android:textSize="18sp"
            android:padding="0dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" km/h"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <!-- 開始 / 儲存 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">

        <Button
            android:id="@+id/btn_start_route"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="▶ 開始路徑模擬"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_save_route"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="💾 儲存路徑"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>
