<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GPSEmulator" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/background</item>
    </style>

    <!-- 強制白底黑字對話框，解決 DayNight 主題導致灰底難以辨識的問題 -->
    <style name="LightDialog" parent="Theme.MaterialComponents.Light.Dialog.Alert">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorAccent">@color/accent</item>
        <!-- 確保對話框底色為純白 -->
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <!-- 文字顏色 -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:textColor">@color/text_primary</item>
        <!-- 確定/取消按鈕樣式 -->
        <item name="buttonBarButtonStyle">@style/LightDialogButton</item>
        <item name="buttonBarPositiveButtonStyle">@style/LightDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/LightDialogButton</item>
    </style>

    <!-- 對話框按鈕：主色藍字，清晰可見 -->
    <style name="LightDialogButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/primary</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>
